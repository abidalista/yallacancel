# Required — Claude API for subscription analysis
ANTHROPIC_API_KEY=

# Required — LlamaParse for PDF text extraction
LLAMA_CLOUD_API_KEY=

# Required — Whop payment verification (api.whop.com/api/v1 — not v5)
WHOP_API_KEY=

# Optional — Whop webhook signature verification (not wired yet)
WHOP_WEBHOOK_SECRET=

# Optional — founder bypass (server-only). Enter this code in paywall → "Have an access code?"
FOUNDER_ACCESS_TOKEN=

# Optional — dev unlock without Whop (local testing)
NEXT_PUBLIC_DEV_UNLOCK=true

# Optional — Whop plan ID (defaults to plan_3E0V8cxU8VYXI)
NEXT_PUBLIC_WHOP_PLAN_ID=

# PostHog (EU). Required at BUILD time for Cloudflare Pages (NEXT_PUBLIC_* is inlined).
# GitHub Actions secret: NEXT_PUBLIC_POSTHOG_KEY
# Optional host override (default https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Alias accepted by the client if you already named it this way:
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
